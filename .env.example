# Railway → your Postgres service → Variables
# Locally use DATABASE_PUBLIC_URL; inside Railway reference ${{Postgres.DATABASE_URL}} (private network)
DATABASE_URL="postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/railway"

# Better Auth (admin app). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="<at-least-32-random-characters>"
# Public URL of the admin app
BETTER_AUTH_URL="http://localhost:3001"

# Public URL of the customer site (SEO, links in emails/WhatsApp). Set it in production: when it's
# missing the site still works but logs errors, SEO URLs use the Railway domain and emails go out
# without site/cancel links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Lets Google index the public site (robots.txt + robots meta). Leave empty until the real domain
# is live; set to "on" only in the production web service
SITE_INDEXING=""

# ─── Photo uploads from the admin (Cloudflare Images; admin app only) ─────────
# Cloudflare dashboard → right sidebar "Account ID"
CLOUDFLARE_ACCOUNT_ID=""
# API token with ONLY "Account → Cloudflare Images → Edit" permission
CLOUDFLARE_IMAGES_API_TOKEN=""

# ─── Booking protection (optional) ───────────────────────────────────────────
# Header holding the real client IP. Railway sets x-real-ip (default). If Cloudflare's proxy
# (orange cloud) is in front of Railway, use cf-connecting-ip instead
# CLIENT_IP_HEADER="cf-connecting-ip"
# Random string mixed into IP hashes used for rate limiting
IP_HASH_SALT="<random-string>"
# Cloudflare Turnstile bot check. Strongly recommended in production: while it's empty the check is
# skipped (an error is logged on every booking). Set both keys or neither
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Email via Resend (optional; logs to console when empty) ──────────────────
# Customer confirmations + same-day reminders, and new-booking alerts to the shop
RESEND_API_KEY=""
# Shop alert recipients, comma-separated (customer emails work without it)
BOOKING_NOTIFY_EMAIL=""
# Must be on a domain verified in Resend. A bare address is shown as "DS Studio <...>"
BOOKING_EMAIL_FROM="contacto@dsstudio.com.uy"

# Signs the "Cancelar turno" links in customer emails (web + admin, same value).
# Without it emails go out with no cancel button. Generate with: openssl rand -base64 32
# Changing it invalidates every link already sent.
BOOKING_LINK_SECRET=""

# Lets the admin refresh the public site's cache right after each save (web + admin, same value).
# Without it, admin edits show up on the site within 5 minutes. Generate with: openssl rand -base64 32
REVALIDATE_SECRET=""

# ─── Daily cron (web + Railway cron service) ─────────────────────────────────
# Protects POST /api/cron/reminders and /api/cron/retention. Generate with: openssl rand -base64 32
CRON_SECRET=""

# ─── WhatsApp Cloud API (optional; messages are skipped until all four are set) ─
# Meta app → WhatsApp → API setup
WHATSAPP_PHONE_NUMBER_ID=""
# System User token with ONLY whatsapp_business_messaging, assigned only to this WABA
WHATSAPP_ACCESS_TOKEN=""
# Meta app → Settings → Basic → App secret (also enable "Require App Secret" there)
WHATSAPP_APP_SECRET=""
# Any long random string; paste the same value when registering the webhook URL
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Optional overrides
# WHATSAPP_GRAPH_VERSION="v26.0"
# WHATSAPP_TEMPLATE_LANGUAGE="es"
